parameters:
    paths:
        - src
        - tests
        - config
    level: max
    excludePaths:
        analyseAndScan:
            - tests/Application/var
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    # The test kernel instantiates bundle classes by name, and which of them PHPStan can resolve
    # depends on the installed Sulu generation. The same ignore therefore matches in one matrix
    # job and not in the other.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Sulu's DimensionContentInterface<T> is self-referential (T of ContentRichEntityInterface,
        # which is itself templated on DimensionContentInterface), so the type arguments cannot be
        # spelled out. Sulu's own decorators sidestep this by typing against already-bound
        # subinterfaces, which do not exist for custom entities.
        -
            identifier: missingType.generics
            path: src/Content/*
        # Version conditional bundle instantiation in the test kernel, see above.
        -
            identifier: argument.type
            path: tests/Application/TestKernel.php
        -
            identifier: return.type
            path: tests/Application/TestKernel.php
